# 腾讯云服务器部署配置（203.195.218.241，源码构建 + docker-compose.deploy.yml）
# 本文件会随仓库提交，只放可公开的运行参数，不写真实密钥。
#
# 首次落地：cp .env.tenxun .env，然后在服务器上执行下面这段把密钥填进 .env：
#   cd ~/ai_canvas
#   DB_PASSWORD="$(openssl rand -hex 32)"
#   sed -i "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=${DB_PASSWORD}|" .env
#   sed -i "s|^DATABASE_URL=.*|DATABASE_URL=postgresql://open_ai_canvas:${DB_PASSWORD}@postgres:5432/open_ai_canvas?sslmode=disable|" .env
#   sed -i "s|^YINGCE_AGENT_TOKEN=.*|YINGCE_AGENT_TOKEN=$(openssl rand -hex 32)|" .env
#   sed -i "s|^CANVAS_UPDATER_TOKEN=.*|CANVAS_UPDATER_TOKEN=$(openssl rand -hex 32)|" .env
#   chmod 600 .env
# 注意：已有 .env 的部署不要重跑上面的密码生成，否则与数据卷里的旧密码不一致。

# --- 对外访问地址 ---
# 公网只暴露 web 的 CANVAS_HTTP_PORT；backend 的 8080 留在 Compose 网络内。
CANVAS_HTTP_PORT=3000
# 生产必须写明确来源，不要留空或 *。
CANVAS_CORS_ORIGINS=http://203.195.218.241:3000
# 服务器对模型上游可访问的地址：本地存储的短时签名链接（生成任务参考图等）由它拼出。
# 必须填外网可达的根地址，不能带 /api；挂 HTTPS 域名后要同步改成新域名。
CANVAS_PUBLIC_BASE_URL=http://203.195.218.241:3000
# 后台「存储设置」里的公网访问地址优先于本变量，两边不一致时以后台为准。

# --- 注册与上游访问策略 ---
CANVAS_REGISTRATION_ENABLED=false
CANVAS_ALLOW_PRIVATE_UPSTREAMS=false
# 可信私网或 HTTP 上游按主机精确放行，例如 gateway.internal,192.168.1.10
CANVAS_ALLOWED_PRIVATE_UPSTREAM_HOSTS=
ENABLE_PROVIDER_PLUGINS=false

# --- PostgreSQL / Redis ---
POSTGRES_DB=open_ai_canvas
POSTGRES_USER=open_ai_canvas
# 密钥：留空，部署时按文件头的命令生成；POSTGRES_PASSWORD 与 DATABASE_URL 里的密码必须一致。
POSTGRES_PASSWORD=eda8b07808c241e8ec60edd7f52881b860a55f1aeef67f323212ccd311249980
DATABASE_URL=postgresql://open_ai_canvas:eda8b07808c241e8ec60edd7f52881b860a55f1aeef67f323212ccd311249980@postgres:5432/open_ai_canvas?sslmode=disable
REDIS_URL=redis://redis:6379/0
# 数据落在宿主机目录时便于直接备份；注释掉则使用命名卷 backend-data。
CANVAS_DATA_PATH=./data

# --- 镜像：源码构建叠加 docker-compose.build.yml，固定使用 :server 本地标签 ---
CANVAS_IMAGE_TAG=source
CANVAS_BACKEND_IMAGE=open-ai-canvas-backend:server
CANVAS_WEB_IMAGE=open-ai-canvas-web:server
CANVAS_YINGCE_AGENT_IMAGE=open-ai-canvas-yingce-agent:server
# 国内服务器构建后端镜像时走镜像代理。
GOPROXY=https://goproxy.cn,direct

# --- 密钥：留空，部署时生成，不要提交真实值 ---
# deploy 编排里缺任一都会在变量插值阶段直接报错。
YINGCE_AGENT_TOKEN=f228dfe038738b98e23d86cfe4da941cb45645c66a9c0aac989bacca482ab1e4
CANVAS_UPDATER_TOKEN=4694fdf9e850cd34897a92cd0b426ffb11f209bb7ef8855b017cdba488232cf8
CANVAS_UPDATER_SOCKET_DIR=/run/open-ai-canvas-updater

# --- 运行时 ---
CANVAS_WORKER_CONCURRENCY=3
CANVAS_CHANNEL_CONCURRENCY=3
CANVAS_SHUTDOWN_TIMEOUT=10m
# deploy 编排里 backend 固定 CANVAS_AUTO_MIGRATE=false，迁移由独立 migrate 服务执行。
CANVAS_AUTO_MIGRATE=true
# 时间线字幕转写依赖本地 whisper.cpp 服务，未部署则转写任务会明确失败。
CANVAS_WHISPER_BASE_URL=
# 留空时在 PATH 中查找 ffmpeg。
CANVAS_FFMPEG_PATH=
CANVAS_LOG_LEVEL=info
CANVAS_LOG_FORMAT=text
